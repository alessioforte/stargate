{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Stargate Helm values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment",
    "replicaCount",
    "image",
    "serviceAccount",
    "containerPort",
    "service",
    "traefik",
    "trustedProxies",
    "internalContext",
    "runtimeConfig",
    "jwt",
    "runtimeSecret",
    "gatewayConfig",
    "persistence",
    "bootstrap"
  ],
  "properties": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "annotations", "revisionHistoryLimit", "minReadySeconds", "strategy"],
      "properties": {
        "mode": { "type": "string", "enum": ["edge", "cluster"] },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rollingUpdate"],
          "properties": {
            "type": { "type": "string", "enum": ["", "Recreate", "RollingUpdate"] },
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxSurge", "maxUnavailable"],
              "properties": {
                "maxSurge": { "$ref": "#/definitions/intOrPercent" },
                "maxUnavailable": { "$ref": "#/definitions/intOrPercent" }
              }
            }
          }
        }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "$ref": "#/definitions/stringMap" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "annotations", "name", "automountServiceAccountToken"],
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations", "sessionAffinity"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "sessionAffinity": {
          "type": "string",
          "enum": ["None", "ClientIP"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "hosts", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string", "minLength": 1 },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "pathType"],
                  "properties": {
                    "path": { "type": "string", "pattern": "^/" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Exact", "Prefix", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "traefik": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "entryPoints", "tls", "identityHost", "apiHosts", "grpc", "adminAllowList"],
      "properties": {
        "enabled": { "type": "boolean" },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretName", "certResolver"],
          "properties": {
            "secretName": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "certResolver": { "type": "string" }
          }
        },
        "identityHost": {
          "oneOf": [
            { "type": "string", "const": "" },
            { "$ref": "#/definitions/hostname" }
          ]
        },
        "apiHosts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/hostname" }
        },
        "grpc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "adminAllowList": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "sourceRange", "ipStrategyDepth"],
          "properties": {
            "enabled": { "type": "boolean" },
            "sourceRange": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "pattern": "^[^,\\s]+$" }
            },
            "ipStrategyDepth": { "type": "integer", "minimum": 0 }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "properties": { "sourceRange": { "minItems": 1 } } }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "properties": { "identityHost": { "minLength": 1 } } }
        }
      ]
    },
    "trustedProxies": {
      "type": "array",
      "uniqueItems": true,
      "description": "Trusted peer CIDRs, one entry per item; use the actual Traefik pod network.",
      "items": { "type": "string", "minLength": 1, "pattern": "^[^,\\s]+$" }
    },
    "internalContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "existingSecret", "mountPath", "issuer", "kid"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "mountPath": { "type": "string", "pattern": "^/" },
        "issuer": { "type": "string" },
        "kid": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "properties": {
              "existingSecret": { "minLength": 1 },
              "issuer": { "minLength": 1 },
              "kid": { "minLength": 1 }
            }
          }
        }
      ]
    },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "behavior"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "behavior": { "type": "object" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "$ref": "#/definitions/nullableIntOrPercent" },
        "maxUnavailable": { "$ref": "#/definitions/nullableIntOrPercent" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "policyTypes", "ingress", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "policyTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["Ingress", "Egress"] }
        },
        "ingress": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "runtimeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "existingConfigMap", "rolloutToken", "annotations", "data"],
      "properties": {
        "create": { "type": "boolean" },
        "existingConfigMap": { "type": "string" },
        "rolloutToken": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "data": { "$ref": "#/definitions/stringMap" }
      }
    },
    "jwt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeKid", "idTokenKid", "keys"],
      "properties": {
        "activeKid": { "$ref": "#/definitions/keyId" },
        "idTokenKid": { "$ref": "#/definitions/keyId" },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kid", "secretName"],
            "properties": {
              "kid": { "allOf": [{ "$ref": "#/definitions/keyId" }], "minLength": 1 },
              "secretName": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
              }
            }
          }
        }
      }
    },
    "runtimeSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "existingSecret", "rolloutToken", "annotations", "stringData"],
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "rolloutToken": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "stringData": { "$ref": "#/definitions/stringMap" }
      }
    },
    "gatewayConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "importOnUpgrade",
        "existingConfigMap",
        "annotations",
        "mountPath",
        "fileName",
        "policiesFileName",
        "config",
        "policies"
      ],
      "properties": {
        "create": { "type": "boolean" },
        "importOnUpgrade": { "type": "boolean", "default": false },
        "existingConfigMap": { "type": "string" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "fileName": { "type": "string", "pattern": "^[^/]+$" },
        "policiesFileName": { "type": "string", "const": "policies" },
        "config": { "type": "string", "minLength": 1 },
        "policies": { "type": "string" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "annotations",
        "mountPath",
        "seed"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "size": { "type": "string", "minLength": 1 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "seed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "email",
        "name",
        "nickname",
        "oauthClientId",
        "oauthRedirectUri",
        "existingSecret",
        "passwordKey",
        "rolloutToken",
        "backoffLimit",
        "activeDeadlineSeconds",
        "annotations",
        "podAnnotations"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "oauthClientId": { "type": "string", "minLength": 1 },
        "oauthRedirectUri": { "type": "string" },
        "existingSecret": { "type": "string" },
        "passwordKey": { "type": "string", "minLength": 1 },
        "rolloutToken": { "type": "string" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" }
      }
    },
    "command": { "type": "array", "items": { "type": "string" } },
    "args": { "type": "array", "items": { "type": "string" } },
    "lifecycle": { "type": "object" },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "initContainers": { "type": "array", "items": { "type": "object" } },
    "sidecars": { "type": "array", "items": { "type": "object" } },
    "priorityClassName": { "type": "string" },
    "runtimeClassName": { "type": "string" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array", "items": { "type": "object" } }
  },
  "definitions": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*\\.?$"
    },
    "keyId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]*$"
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "intOrPercent": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+%$" }
      ]
    },
    "nullableIntOrPercent": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+%$" }
      ]
    },
    "probe": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
