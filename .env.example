# =============================================================================
# Server
# =============================================================================

# Port the HTTP/HTTPS server listens on
PORT=5050

# Hostname used in OpenAPI server URL and generated links
# HOSTNAME=localhost

# Runtime profile override. Must match the compiled profile (debug or release).
# STARGATE_RUNTIME_PROFILE=release

# Graceful shutdown window for draining requests before final persistence hooks run
# SERVER_SHUTDOWN_TIMEOUT_SECS=25

# =============================================================================
# TLS
# =============================================================================

# Enable TLS termination
TLS_ENABLED=false

# Paths to the TLS certificate and private key (required when TLS_ENABLED=true)
# TLS_CERT=.stargate/certificate/localhost/cert.pem
# TLS_KEY=.stargate/certificate/localhost/key.pem

# =============================================================================
# Config file
# =============================================================================

# Directory where stargate reads/writes its config file
# CONFIG_PATH=.stargate

# Name of the config file inside CONFIG_PATH
# CONFIG_FILENAME=config.yaml

# =============================================================================
# Gateway
# =============================================================================

# Max request body buffered for mirror traffic and response-status failover replay
# GATEWAY_REPLAY_BODY_LIMIT=2MiB

# =============================================================================
# Logging
# =============================================================================

# Tracing/log filter directive (e.g. "info", "debug", "warn,actix_web=info")
RUST_LOG=info

# Directory where log files are written
# LOG_DIR=.stargate/logs

# Enable writing logs to a file
# LOG_FILE_ENABLED=true

# Enable writing logs to stdout/stderr
# LOG_CONSOLE_ENABLED=true

# Use pretty (human-readable) formatting for console output
# LOG_PRETTY_CONSOLE=true

# =============================================================================
# OpenTelemetry
# =============================================================================

# Enable OTLP traces, metrics, and logs. Defaults to true when an OTLP endpoint is set.
# OTEL_ENABLED=true

# Service name attached to telemetry resources
# OTEL_SERVICE_NAME=stargate

# Shared OTLP endpoint. Use http://localhost:4317 for gRPC or http://localhost:4318 for HTTP/protobuf.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# OTLP transport protocol: grpc or http/protobuf
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Signal-specific endpoints override OTEL_EXPORTER_OTLP_ENDPOINT when set.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4317

# =============================================================================
# PostgreSQL
# =============================================================================

POSTGRES_ENDPOINT=localhost:5432
POSTGRES_DATABASE=stargate
POSTGRES_USERNAME=root
POSTGRES_PASSWORD=root

# Maximum number of connections in the database pool
# DB_POOL_MAX=10

# =============================================================================
# Redis (optional — only used with the redis feature flag)
# =============================================================================

# Redis connection URL
# REDIS_URL=redis://localhost:6379

# Number of connections in the Redis pool
# REDIS_POOL_SIZE=10

# =============================================================================
# In-memory store (used when built without the redis feature)
# =============================================================================

# Maximum memory the in-memory store may consume, in megabytes
# STORE_MAX_MEMORY_MB=256

# How often (in seconds) the in-memory store is persisted to disk
# STORE_BACKUP_INTERVAL_SECS=60

# Minimum number of writes since the last backup before a new backup is triggered
# STORE_BACKUP_WRITE_THRESHOLD=100

# =============================================================================
# JWT
# =============================================================================

# Signing algorithm. Supported: HS256, HS384, HS512, RS256, RS384, RS512,
# PS256, PS384, PS512, ES256, ES384, EdDSA
JWT_ALGORITHM=RS256

# HMAC secret (used only with HS* algorithms). Generate with: openssl rand -hex 64
JWT_SECRET=change_me

# Path to the RSA/EC public key PEM file (used with RS*, PS*, ES*, EdDSA algorithms)
# JWT_PUBLIC_KEY=.stargate/jwks/public.pem

# Issuer claim embedded in every token and exposed in OAuth metadata
JWT_ISSUER=http://localhost:5050

# Key ID embedded in JWT headers and exposed on asymmetric JWKS keys
JWT_KID=stargate-current

# Optional public base URL for metadata endpoint links when it differs from JWT_ISSUER
# OAUTH_BASE_URL=http://localhost:5050

# JWKS cache max-age in seconds
JWKS_CACHE_MAX_AGE_SECS=300

# Access token lifetime (e.g. "15m", "1h")
JWT_ACCESS_EXP=1h

# Refresh token lifetime (e.g. "1d", "7d")
JWT_REFRESH_EXP=1d

# =============================================================================
# OAuth/OIDC provider
# =============================================================================

# OAuth provider uses JWT_ISSUER, OAUTH_BASE_URL, JWT_KID, and JWKS_CACHE_MAX_AGE_SECS above.
# OAuth refresh-token families use the shared store backend:
# Edge: memory store backup settings above control persistence.
# Cluster: Redis persistence should be configured at the Redis layer.

# =============================================================================
# SMTP
# =============================================================================

SMTP_HOST=0.0.0.0
SMTP_PORT=1025

# Sender address shown in outgoing emails
# SMTP_FROM=NoBody <nobody@domain.tld>

# SMTP credentials (leave empty for unauthenticated relay)
# SMTP_USERNAME=
# SMTP_PASSWORD=

# =============================================================================
# Email OTP
# =============================================================================

# Server-side pepper used to HMAC email OTP and MFA challenges. Generate with:
# openssl rand -hex 32
# EMAIL_OTP_PEPPER=

# Email OTP code length, TTL, and max verification attempts
# EMAIL_OTP_LENGTH=6
# EMAIL_OTP_TTL_SECS=300
# EMAIL_OTP_MAX_ATTEMPTS=5

# =============================================================================
# MFA
# =============================================================================

# MFA mode. off disables MFA challenges, optional lets users opt in via attrs,
# required requires MFA for all user sessions.
# MFA_MODE=optional

# Enabled MFA methods. Only email is implemented at the moment; sms and totp are reserved.
# MFA_METHODS=email
# MFA_DEFAULT_METHOD=email
# MFA_EMAIL_ENABLED=true
# MFA_REQUIRED_FOR_SUPER_ADMIN=true
# MFA_ADMIN_STEP_UP_REQUIRED=false
# MFA_STEP_UP_TTL_SECS=300

# =============================================================================
# OAuth — Google
# =============================================================================

# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/oauth/google

# =============================================================================
# OAuth — GitHub
# =============================================================================

# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# =============================================================================
# OAuth — LinkedIn
# =============================================================================

# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=

# =============================================================================
# OAuth — Facebook
# =============================================================================

# FACEBOOK_OAUTH_CLIENT_ID=
# FACEBOOK_OAUTH_CLIENT_SECRET=

# =============================================================================
# Network
# =============================================================================

# Comma-separated list of trusted proxy IPs or CIDRs for real-IP extraction
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Allowed CORS origins (comma-separated). Empty = block all cross-origin requests.
# CORS_ORIGINS=http://localhost:3000,https://app.example.com

# Trusted browser origins for sensitive IAM endpoints. Empty = origin guard disabled.
# TRUSTED_ORIGINS=http://localhost:3000,https://app.example.com

# =============================================================================
# GeoIP
# =============================================================================

# Path to the MaxMind GeoLite2-City .mmdb database file
# GEOIP_DB_PATH=.stargate/geoip/GeoLite2-City.mmdb

# =============================================================================
# Audit
# =============================================================================
#
# Audit events are written to the `audits` table in the same transaction as the
# mutation they record (transactional outbox). In CLUSTER deployments a relay
# tails that table and ships rows to Redis Streams; EDGE deployments persist the
# rows but run no relay, so the settings below have no effect on edge.

# Enable the audit relay (set to false to run a node that only writes audit rows,
# e.g. when a dedicated relay node drains the outbox). Default: true
# AUDIT_RELAY_ENABLED=true

# Rows claimed per relay batch. Default: 256
# AUDIT_RELAY_BATCH=256

# Idle poll interval, in milliseconds, when the outbox is caught up. The relay
# drains a full backlog without waiting. Default: 1000
# AUDIT_RELAY_INTERVAL_MS=1000

# Redis stream key audit events are appended to. Default: audit:events
# AUDIT_STREAM=audit:events

# Approximate stream cap (MAXLEN ~). 0 disables trimming (unbounded). The DB
# table always keeps full history regardless of this value. Default: 100000
# AUDIT_STREAM_MAXLEN=100000

# =============================================================================
# Docs
# =============================================================================

# Base URL used to generate links in error responses
# DOCS_URL=https://docs.stargate.dev
